# SQLite for local development. For Postgres, switch the Prisma provider
# in prisma/schema.prisma to "postgresql" and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# Public site URL (used in emails, magic links, and certificate QR codes)
APP_URL="http://localhost:3000"

# Signed session cookies
AUTH_SECRET="replace-with-a-long-random-string"

# Env-seeded admin (not stored in the database)
ADMIN_EMAIL="admin@magisteropus.site"
ADMIN_PASSWORD="changeme"

# SMTP (Hostinger-compatible). If unset, emails are logged to the console.
EMAIL_HOST=""
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="admissions@magisteropus.site"

# Recipient for new-application notifications
ADMIN_NOTIFY_EMAIL=""

# Inserted into the Qualified email [Instructions] block
QUALIFIED_NEXT_STEPS="Please sign in to your student portal with the email address on your application. Your program status will appear there. The admissions team will write if any further documentation is needed."
