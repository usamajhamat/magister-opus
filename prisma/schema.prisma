// SQLite locally. For Postgres: change provider to "postgresql"
// and set DATABASE_URL to a Postgres connection string.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  sortOrder    Int           @default(0)
  applications Application[]
}

model Application {
  id             String       @id @default(cuid())
  number         String       @unique
  fullName       String
  email          String
  phone          String
  country        String
  notes          String?
  status         String       @default("PENDING_REVIEW")
  progress       Int          @default(0)
  idDocumentPath String
  resumePath     String
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  certificate    Certificate?
}

model Certificate {
  id            String      @id @default(cuid())
  number        String      @unique
  title         String
  issuedAt      DateTime    @default(now())
  pdfPath       String
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
